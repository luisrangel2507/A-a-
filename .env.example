# Local development only — copy to .env and edit.
#
# Do NOT paste this DATABASE_URL into Railway or any other host: "localhost"
# there means the app's own container, which has no database, and the deploy
# crashes with ECONNREFUSED 127.0.0.1:5432. On Railway, set the app service's
# variable to a reference instead, so it resolves to the real database host:
#
#     DATABASE_URL=${{Postgres.DATABASE_URL}}

DATABASE_URL=postgres://user:password@localhost:5432/acai_control
PORT=4000
